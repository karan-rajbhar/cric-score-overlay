rules_version = '2';

// Uploads are performed by server actions with the Admin SDK (after the
// caller's permissions are checked), so clients only need read access to
// the public asset folders.
service firebase.storage {
  match /b/{bucket}/o {
    // Readable by anyone, on purpose (see firestore.rules: lint still
    // catches a bare `allow read: if true` as a possible mistake).
    function publicData() {
      return true;
    }

    match /team-logos/{allPaths=**}  { allow read: if publicData(); allow write: if false; }
    match /club-assets/{allPaths=**} { allow read: if publicData(); allow write: if false; }
    // Club / tournament sponsor logos for the overlay (server-validated).
    match /sponsor-logos/{allPaths=**} { allow read: if publicData(); allow write: if false; }
    match /{allPaths=**}             { allow read, write: if false; }
  }
}
