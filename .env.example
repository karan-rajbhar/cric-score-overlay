# ------------------------------------------------------------------------------
# Local development (default): everything runs on the Firebase Emulator Suite.
# No Firebase project or secrets are needed. Start with:
#   npm run emulators   (terminal 1)   -> Auth :9099, Firestore :8088, Storage :9199, UI :4000
#   npm run seed        (once)         -> loads firebase/seed/data.json + demo accounts
#   npm run dev         (terminal 2)   -> http://localhost:3005
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cricscore

# Testing from a phone on the same Wi-Fi? Point the browser at your LAN IP.
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.20

# ------------------------------------------------------------------------------
# Production: values from Firebase console -> Project settings -> Your apps.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account JSON (raw or base64) so the server can verify sessions and write data.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Sign-in is Google-only and invite-only. These emails may always sign in (the
# first admins); everyone else needs an invite from an existing user.
# ALLOWED_EMAILS=you@gmail.com
