rules_version = '2';

// All writes go through Next.js server actions using the Admin SDK, which
// bypasses these rules. Browsers only read, and only the data the app shows
// publicly (live scores, directories, profiles) plus the caller's own rows.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Invite-only: only accounts that passed the invite check have a profile.
    function member() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Public directory and profile data. `users` holds no contact details;
    // those live in users_private (server only, below).
    match /users/{id}                    { allow read: if true; allow write: if false; }
    match /clubs/{id}                    { allow read: if true; allow write: if false; }
    match /club_seasons/{id}             { allow read: if true; allow write: if false; }
    match /club_hall_of_fame/{id}        { allow read: if true; allow write: if false; }
    match /teams/{id}                    { allow read: if true; allow write: if false; }
    match /team_players/{id}             { allow read: if true; allow write: if false; }
    match /tournaments/{id}              { allow read: if true; allow write: if false; }
    match /tournament_registrations/{id} { allow read: if true; allow write: if false; }
    match /tournament_standings/{id}     { allow read: if true; allow write: if false; }
    match /player_career_stats/{id}      { allow read: if true; allow write: if false; }
    // Tournament / club leaderboards (per-player figures and display names).
    match /leaderboards/{id}             { allow read: if true; allow write: if false; }

    // Live scoring data is public so spectators and overlays can follow.
    // Innings carry their scorecard; the ball log is one document per over.
    match /matches/{id}                  { allow read: if true; allow write: if false; }
    match /innings/{id}                  { allow read: if true; allow write: if false; }
    match /overs/{id}                    { allow read: if true; allow write: if false; }
    // Per-player record of each match (career and player pages).
    match /player_matches/{id}           { allow read: if true; allow write: if false; }
    // Denormalized live scoreboard (one doc per match), written by the scoring engine.
    match /live_state/{id}               { allow read: if true; allow write: if false; }
    // Compact scorecard of every innings (match page tabs while live).
    match /live_scorecard/{id}           { allow read: if true; allow write: if false; }

    // A signed-in user may read their own memberships; everything else is
    // server-rendered.
    match /club_memberships/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }
    match /club_invitations/{id}         { allow read, write: if false; }
    // Contact details (email, phone) keyed by user id: Admin SDK only.
    match /users_private/{id}            { allow read, write: if false; }
    match /invitations/{id}              { allow read, write: if false; }

    // Realtime broadcast messages (score pings, overlay producer commands).
    match /broadcasts/{topic}/messages/{id} {
      allow read: if true;
      allow create: if member()
        && request.resource.data.keys().hasAll(['event', 'ts'])
        && request.resource.data.event is string;
      allow update, delete: if false;
    }
  }
}
