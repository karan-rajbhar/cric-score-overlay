# ==============================================================================
# CricScore Production Environment Variables
# ==============================================================================

# Supabase Production Project URL & Keys
# Obtain from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Domain / HTTPS Configuration (Caddy automatically issues Let's Encrypt certificates)
# Set APP_DOMAIN to your custom domain (e.g. cric.yourdomain.com), or leave empty for direct IP on port 80
APP_DOMAIN=
LETSENCRYPT_EMAIL=admin@example.com

# Node Environment
NODE_ENV=production
SKIP_ENV_VALIDATION=1
